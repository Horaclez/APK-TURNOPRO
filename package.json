    "react-dom": "18.3.1",
    "jszip": "3.10.1",
    "jspdf": "2.5.1",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tailwindcss": "3.4.17",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
